rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 許可するメールアドレス。家族などで共有する場合はここに追加する
    // (1つだけの場合も配列のままでよい)
    function allowedEmails() {
      return ["al1cealwayswithu@gmail.com"];
    }

    // メールアドレスが「確認済み」であることも求めるかどうか。
    // 有効にするには、下の行を
    //   return request.auth.token.email_verified == true;
    // に書き換える。ただし現在ログイン中のアカウントが未確認だと、有効にした
    // 瞬間に自分も締め出されるので、先にメールの確認を済ませること。
    // (このアプリは確認メールを送っていないため、通常は未確認のまま。
    //  Firebase Authentication は同じメールでの重複登録を拒否するので、
    //  これが無くても他人が同じメールで入ってくることはない)
    function emailIsVerifiedEnough() {
      return true;
    }

    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email in allowedEmails()
        && emailIsVerifiedEnough();
    }

    // 許可されたメールアドレスの本人のみ、自分の記録 (users/{uid}/entries/*) に
    // アクセスできる。他の人がアカウントを作成しても、このメールアドレスと
    // 一致しない限り一切の読み書きができない。
    match /users/{userId}/entries/{entryId} {
      allow read, write: if isOwner(userId);
    }

    // 予算などの設定 (users/{uid}/settings/*) も同様に本人のみアクセス可能
    match /users/{userId}/settings/{docId} {
      allow read, write: if isOwner(userId);
    }

    // それ以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
