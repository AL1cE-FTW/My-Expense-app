rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 許可されたメールアドレスの本人のみ、自分の記録 (users/{uid}/entries/*) に
    // アクセスできる。他の人がアカウントを作成しても、このメールアドレスと
    // 一致しない限り一切の読み書きができない。
    match /users/{userId}/entries/{entryId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email == "al1cealwayswithu@gmail.com";
    }

    // それ以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
